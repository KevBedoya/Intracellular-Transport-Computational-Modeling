# Generated output. Lives at the repo root (see
# system_configuration/file_paths.py BASE_DIR) so it stays out of src/.
# The directory skeleton is kept via .gitkeep files; the results themselves are
# not committed from here -- anything worth keeping is promoted into results/.
data_output/*
!data_output/.gitkeep
!data_output/*/
data_output/*/*
!data_output/*/.gitkeep

data_output/progress-notes


